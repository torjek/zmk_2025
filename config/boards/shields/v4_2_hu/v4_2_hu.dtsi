#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)    RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6)    RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 94 94 3 50 0 0 0>
              , <&key_physical_attrs 94 94 102 42 0 0 0>
              , <&key_physical_attrs 94 94 202 21 0 0 0>
              , <&key_physical_attrs 94 94 302 3 0 0 0>
              , <&key_physical_attrs 94 94 402 37 0 0 0>
              , <&key_physical_attrs 94 94 501 55 0 0 0>
              , <&key_physical_attrs 42 42 635 391 0 0 0>
              , <&key_physical_attrs 94 94 1940 50 0 0 0>
              , <&key_physical_attrs 94 94 1840 42 0 0 0>
              , <&key_physical_attrs 94 94 1740 21 0 0 0>
              , <&key_physical_attrs 94 94 1641 3 0 0 0>
              , <&key_physical_attrs 94 94 1541 37 0 0 0>
              , <&key_physical_attrs 94 94 1441 55 0 0 0>
              , <&key_physical_attrs 42 42 1360 391 0 0 0>
              , <&key_physical_attrs 94 94 3 150 0 0 0>
              , <&key_physical_attrs 94 94 102 142 0 0 0>
              , <&key_physical_attrs 94 94 202 121 0 0 0>
              , <&key_physical_attrs 94 94 302 103 0 0 0>
              , <&key_physical_attrs 94 94 402 137 0 0 0>
              , <&key_physical_attrs 94 94 501 155 0 0 0>
              , <&key_physical_attrs 42 42 635 465 0 0 0>
              , <&key_physical_attrs 94 94 1940 150 0 0 0>
              , <&key_physical_attrs 94 94 1840 142 0 0 0>
              , <&key_physical_attrs 94 94 1740 121 0 0 0>
              , <&key_physical_attrs 94 94 1641 103 0 0 0>
              , <&key_physical_attrs 94 94 1541 137 0 0 0>

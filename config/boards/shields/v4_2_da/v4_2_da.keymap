#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#ifndef SIMPLE_MODE
#define SIMPLE_MODE 0
#endif

#define BASE 0
#define BLUE 1
#define RED 2
#define ORANGE 3
#define NAV  4
#define SYM  5
#define ADJ  6

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <170>;
};

/ {
        combos {
    compatible = "zmk,combos";

    // Blue/space
    //// Row 0 (Numbers)
    combo_n1_space { timeout-ms = <60>; key-positions = <1 61>; bindings = <&macro_n1_space>; slow-release; }; 
    combo_n2_space { timeout-ms = <60>; key-positions = <2 61>; bindings = <&macro_n2_space>; slow-release; }; 
    combo_n3_space { timeout-ms = <60>; key-positions = <3 61>; bindings = <&macro_n3_space>; slow-release; }; 
    combo_n4_space { timeout-ms = <60>; key-positions = <4 61>; bindings = <&macro_n4_space>; slow-release; }; 
    combo_n5_space { timeout-ms = <60>; key-positions = <5 61>; bindings = <&macro_n5_space>; slow-release; }; 

    // Row 1 (Qwerty Top Letters)
    combo_q_space { timeout-ms = <60>; key-positions = <15 61>; bindings = <&macro_q_space>; slow-release; }; 
    combo_w_space { timeout-ms = <60>; key-positions = <16 61>; bindings = <&macro_w_space>; slow-release; };    
